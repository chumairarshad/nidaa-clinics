# ============================================================
# NiDAA Clinic — Production SEO Blog CMS Environment Variables
# Copy to .env.local and populate with your production credentials
# ============================================================

# 1. Supabase PostgreSQL Connection (Shared Database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Note: NEXT_PUBLIC_SUPABASE_ANON_KEY is also supported as an alias

# 2. Server-Only Cache Revalidation Secret (Never expose to browser)
# Must match REVALIDATION_SECRET in the admin CMS project
REVALIDATION_SECRET=your-64-character-random-hex-secret-here

# 3. Canonical Domain & Production URLs
NEXT_PUBLIC_SITE_URL=https://nidaclinic.com
BLOGPANEL_SITE_URL=https://nidaclinic.com
BLOGPANEL_SITE_NAME=NiDAA Clinic Blog

# 4. Optional Legacy Database / Admin Key (If using embedded MongoDB / BlogPanel)
BLOGPANEL_MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/nidaaclinic?retryWrites=true&w=majority
BLOGPANEL_API_KEY=your_secure_32_character_master_key_here
